<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <h1 class="hero-title" id="hero-heading">Welcome to BlogSphere</h1>
      <p class="hero-subtitle">A space to express your creativity, share knowledge, and discover stories from writers around the globe.</p>
      <a href="/posts/new" class="btn btn-primary" id="hero-create-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Write your first story
      </a>
    </section>

    <!-- Recent Posts Section -->
    <section class="recent-posts-section">
      <div class="section-header">
        <h2 class="section-title">Recent Stories</h2>
        <a href="/posts" class="btn btn-secondary" id="view-all-btn">
          View All Blogs
        </a>
      </div>

      <% if (posts && posts.length > 0) { %>
        <div class="blog-grid">
          <% posts.slice(0, 3).forEach(post => { %>
            <article class="post-card" id="post-card-<%= post.id %>">
              <div class="post-card-body">
                <div class="post-card-meta">
                  <span class="post-card-date"><%= post.createdAt %></span>
                </div>
                <h3 class="post-card-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                <p class="post-card-excerpt">
                  <%= post.content.length > 150 ? post.content.substring(0, 150) + '...' : post.content %>
                </p>
                <div class="post-card-footer">
                  <span class="post-card-author"><%= post.author %></span>
                  <a href="/posts/<%= post.id %>" class="read-more-link">
                    Read More 
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="form-container" style="text-align: center; padding: 48px;">
          <h3 style="margin-bottom: 12px; font-weight: 600;">No posts found</h3>
          <p style="margin-bottom: 24px; color: var(--text-secondary);">Be the first to share your thoughts with the world!</p>
          <a href="/posts/new" class="btn btn-primary">Create a Post</a>
        </div>
      <% } %>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
