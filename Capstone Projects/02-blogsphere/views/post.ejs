<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="post-detail-container">
      
      <!-- Back Navigation Header -->
      <div style="margin-bottom: 24px;">
        <a href="/posts" class="btn btn-secondary" style="padding: 8px 16px; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Blogs
        </a>
      </div>

      <!-- Post Meta Header -->
      <header class="post-header">
        <h1 class="post-title" id="post-detail-title"><%= post.title %></h1>
        <div class="post-meta">
          <div class="post-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="post-meta-icon"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>By <strong id="post-detail-author"><%= post.author %></strong></span>
          </div>
          <div class="post-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="post-meta-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span id="post-detail-date">Published on <%= post.createdAt %></span>
          </div>
          <% if (post.updatedAt && post.updatedAt !== post.createdAt) { %>
            <div class="post-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="post-meta-icon"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
              <span id="post-detail-updated">Updated on <%= post.updatedAt %></span>
            </div>
          <% } %>
        </div>
      </header>

      <!-- Post Main Content Body -->
      <article class="post-content" id="post-detail-content"><%= post.content %></article>

      <!-- Post Actions Buttons Row -->
      <footer class="post-actions">
        <a href="/posts" class="btn btn-outline" id="post-back-btn">
          &larr; Back to Blogs
        </a>
        <div class="post-action-buttons">
          <a href="/posts/<%= post.id %>/edit" class="btn btn-secondary" id="post-edit-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Edit Post
          </a>
          
          <!-- Delete Post Action Form -->
          <form action="/posts/<%= post.id %>/delete" method="POST" id="delete-form" style="display: inline;">
            <button type="submit" class="btn btn-danger" id="post-delete-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              Delete Post
            </button>
          </form>
        </div>
      </footer>

    </div>
  </div>
</main>

<!-- Styled Delete Confirmation Modal Overlay -->
<div class="modal-overlay" id="delete-modal">
  <div class="modal-content">
    <h3 class="modal-title">Delete Post?</h3>
    <p class="modal-body">Are you sure you want to delete this post? This action is permanent and cannot be undone.</p>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" id="cancel-delete-btn">Cancel</button>
      <button type="button" class="btn btn-danger" id="confirm-delete-btn">Delete</button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
