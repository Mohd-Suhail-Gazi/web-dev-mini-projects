<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <!-- Header Area -->
    <div class="section-header">
      <h1 class="section-title">All Blog Stories</h1>
      <a href="/posts/new" class="btn btn-primary" id="all-blogs-create-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Create Post
      </a>
    </div>

    <!-- Blog Grid -->
    <% if (posts && posts.length > 0) { %>
      <div class="blog-grid">
        <% posts.forEach(post => { %>
          <article class="post-card" id="post-card-<%= post.id %>">
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-card-date"><%= post.createdAt %></span>
              </div>
              <h3 class="post-card-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt">
                <%= post.content.length > 180 ? post.content.substring(0, 180) + '...' : post.content %>
              </p>
              <div class="post-card-footer">
                <span class="post-card-author"><%= post.author %></span>
                <a href="/posts/<%= post.id %>" class="read-more-link">
                  Read More 
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="form-container" style="text-align: center; padding: 64px 32px;">
        <h3 style="margin-bottom: 12px; font-weight: 600; font-size: 1.5rem;">No stories posted yet</h3>
        <p style="margin-bottom: 32px; color: var(--text-secondary);">Be the first creator to share your story on BlogSphere!</p>
        <a href="/posts/new" class="btn btn-primary">Write a Post</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
