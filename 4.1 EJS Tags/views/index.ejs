<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EJS Tags</title>
</head>

<body>
  <h1>
    <!-- Tite goes here -->
     <%= title %>
  </h1>
  <% if (seconds % 2 === 0) { %>

  <% for (let i = 0; i < items.length; i++) { %>
    <p>The item is <%= items[i] %></p>
  <% } %>

<% } else { %>

  <p>Nothing to display</p>

<% } %>
  <p>
    <!-- HTML content goes here -->
    <%- htmlContent %>

  </p>

  <!-- Footer goes here -->
  <%- include("footer.ejs")%>
</body>

</html>